.empty {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  padding: 80rpx 24rpx; color: var(--text-sub);
}
.empty .ico { font-size: 80rpx; margin-bottom: 16rpx; }
.empty .txt { font-size: 26rpx; color: var(--text-mute); }
.empty .btn {
  margin-top: 32rpx; padding: 0 40rpx; height: 72rpx; line-height: 72rpx;
  background: var(--primary); color: #fff; border-radius: 999rpx; font-size: 28rpx;
}
