/* ============================================================
 * 全局样式（设计令牌 + 通用组件类）
 * 颜色取自需求规格：茶饮红 + 明黄；375 设计稿，用 rpx 自适应
 * ============================================================ */

page {
  --primary: #E4002B;
  --primary-dark: #C10024;
  --primary-light: #FFE6EC;
  --accent: #FFD100;
  --text: #1F1F1F;
  --text-sub: #6E6E78;
  --text-mute: #A0A0A8;
  --bg: #F5F6F8;
  --card: #FFFFFF;
  --border: #EEEFF1;
  --danger: #E4002B;
  --success: #2E7D32;
  --warning: #ED6C02;
  --radius: 16rpx;
  --radius-lg: 24rpx;
  --shadow: 0 4rpx 20rpx rgba(20, 20, 30, 0.05);
  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC",
    "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

view, text, image, button, input, scroll-view {
  box-sizing: border-box;
}

/* 通用容器 */
.container { padding: 24rpx; }
.row { display: flex; flex-direction: row; align-items: center; }
.col { display: flex; flex-direction: column; }
.flex-between { display: flex; align-items: center; justify-content: space-between; }
.flex-1 { flex: 1; min-width: 0; }
.gap-8 { gap: 8rpx; }
.gap-12 { gap: 12rpx; }
.gap-16 { gap: 16rpx; }
.gap-20 { gap: 20rpx; }
.gap-24 { gap: 24rpx; }
.mt-8 { margin-top: 8rpx; } .mt-12 { margin-top: 12rpx; } .mt-16 { margin-top: 16rpx; }
.mt-20 { margin-top: 20rpx; } .mt-24 { margin-top: 24rpx; } .mt-32 { margin-top: 32rpx; }
.mb-12 { margin-bottom: 12rpx; } .mb-16 { margin-bottom: 16rpx; } .mb-24 { margin-bottom: 24rpx; }
.text-sub { color: var(--text-sub); }
.text-mute { color: var(--text-mute); }
.text-primary { color: var(--primary); }
.text-strong { font-weight: 600; }
.text-sm { font-size: 24rpx; }
.text-xs { font-size: 22rpx; }
.text-lg { font-size: 32rpx; }
.text-xl { font-size: 36rpx; }
.text-xxl { font-size: 44rpx; }
.text-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.text-ellipsis-2 {
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
  overflow: hidden; word-break: break-all;
}

/* 卡片 */
.card {
  background: var(--card);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  padding: 24rpx;
}
.card-tight { padding: 16rpx 20rpx; }

/* 主按钮 */
.btn-primary {
  background: var(--primary);
  color: #fff;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border: none;
  display: block;
  width: 100%;
}
.btn-primary[disabled], .btn-primary.disabled { background: #F2B5BE; color: #fff; }
.btn-ghost {
  background: var(--primary-light);
  color: var(--primary);
  border-radius: 999rpx;
  font-size: 28rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  display: block;
  width: 100%;
}
.btn-line {
  background: #fff;
  color: var(--text);
  border: 2rpx solid var(--border);
  border-radius: 999rpx;
  font-size: 28rpx;
  height: 72rpx;
  line-height: 68rpx;
  text-align: center;
  display: block;
  width: 100%;
}
button::after { border: none; }

/* 标签 */
.tag {
  display: inline-block;
  padding: 4rpx 14rpx;
  font-size: 22rpx;
  border-radius: 8rpx;
  background: var(--primary-light);
  color: var(--primary);
  margin-right: 8rpx;
  line-height: 1.4;
}
.tag-ghost { background: #F0F0F3; color: var(--text-sub); }
.tag-accent { background: var(--accent); color: #5A4500; }
.tag-success { background: #E6F4EA; color: var(--success); }
.tag-warn { background: #FFF4E5; color: var(--warning); }
.tag-gray { background: #EEF0F2; color: #8A8A8F; }

/* 标题 */
.section-title {
  display: flex; align-items: center; justify-content: space-between;
  font-size: 30rpx; font-weight: 600; color: var(--text);
  padding: 24rpx 24rpx 12rpx;
}
.section-title .more { font-size: 24rpx; color: var(--text-sub); font-weight: 400; }

/* 分割 */
.divider { height: 1rpx; background: var(--border); margin: 16rpx 0; }

/* 安全区 */
.safe-bottom { padding-bottom: calc(20rpx + env(safe-area-inset-bottom)); }
.tabbar-spacer { height: calc(120rpx + env(safe-area-inset-bottom)); }

/* 图片占位：所有占位图通用 */
.ph {
  display: flex; align-items: center; justify-content: center;
  font-size: 64rpx; color: rgba(255,255,255,0.95);
  width: 100%; height: 100%;
  text-shadow: 0 4rpx 12rpx rgba(0,0,0,0.12);
  border-radius: inherit;
}
.ph-sm { font-size: 40rpx; }
.ph-lg { font-size: 96rpx; }

/* 数量步进 */
.stepper {
  display: inline-flex; align-items: center; background: #fff; border-radius: 999rpx;
  padding: 4rpx; border: 2rpx solid var(--border);
}
.stepper .op {
  width: 52rpx; height: 52rpx; line-height: 48rpx; text-align: center;
  font-size: 36rpx; color: var(--primary);
}
.stepper .op.disabled { color: #C0C0C5; }
.stepper .val {
  min-width: 60rpx; text-align: center; font-size: 28rpx; color: var(--text);
  font-weight: 600;
}

/* 骨架 */
.skeleton {
  background: linear-gradient(90deg, #ECEDF0 25%, #F5F6F8 37%, #ECEDF0 63%);
  background-size: 400% 100%;
  animation: sk 1.4s ease infinite;
  border-radius: 8rpx;
}
@keyframes sk {
  0% { background-position: 100% 50%; }
  100% { background-position: 0 50%; }
}

/* loading 蒙层 */
.page-loading {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0;
  display: flex; align-items: center; justify-content: center;
  background: rgba(255,255,255,0.6);
  z-index: 9;
}

/* 列表公共行 */
.row-item {
  display: flex; align-items: center; padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border);
}
.row-item:last-child { border-bottom: none; }

/* 弹层 */
.sheet-mask {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0,0,0,0.45); z-index: 99;
}
.sheet {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 100;
  background: #fff; border-top-left-radius: 24rpx; border-top-right-radius: 24rpx;
  padding-bottom: env(safe-area-inset-bottom);
  max-height: 80vh; display: flex; flex-direction: column;
}
.sheet-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 24rpx; font-size: 30rpx; font-weight: 600;
  border-bottom: 1rpx solid var(--border);
}
.sheet-body { flex: 1; overflow-y: auto; padding: 0 24rpx 24rpx; }
.sheet-close { font-size: 40rpx; color: var(--text-mute); padding: 0 8rpx; }
