.page {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0;
  background: linear-gradient(160deg, #E4002B 0%, #FF5B5B 60%, #FFD100 130%);
  display: flex; flex-direction: column; align-items: center; justify-content: space-between;
  padding: 80rpx 48rpx calc(80rpx + env(safe-area-inset-bottom));
  color: #fff;
}
.skip {
  align-self: flex-end;
  padding: 12rpx 28rpx; background: rgba(255,255,255,0.2);
  border-radius: 999rpx; font-size: 24rpx;
}
.brand { display: flex; flex-direction: column; align-items: center; gap: 24rpx; }
.logo {
  font-size: 96rpx; font-weight: 800; letter-spacing: 8rpx;
  background: rgba(255,255,255,0.18);
  padding: 32rpx 56rpx; border-radius: 24rpx;
  box-shadow: 0 12rpx 40rpx rgba(0,0,0,0.18);
}
.slogan { font-size: 30rpx; opacity: 0.92; letter-spacing: 4rpx; }
.dots { display: flex; gap: 14rpx; }
.dot {
  width: 12rpx; height: 12rpx; border-radius: 50%;
  background: rgba(255,255,255,0.4);
  animation: bounce 1.2s infinite ease-in-out;
}
.dot:nth-child(2) { animation-delay: 0.15s; }
.dot:nth-child(3) { animation-delay: 0.3s; }
@keyframes bounce {
  0%, 80%, 100% { transform: scale(0.6); opacity: 0.4; }
  40% { transform: scale(1); opacity: 1; }
}
.footer { font-size: 22rpx; opacity: 0.7; }
