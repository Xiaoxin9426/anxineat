<view class="page" wx:if="{{user}}">
  <view class="hero">
    <view class="avatar" style="background:{{avatar.bg}}">{{avatar.emoji}}</view>
    <view class="name text-strong">{{user.nickname || '访客'}}</view>
    <view class="meta">
      <text class="tag tag-accent">{{user.levelName || '普通会员'}}</text>
      <text class="phone" wx:if="{{user.phone}}">{{user.phone}}</text>
    </view>
    <view class="points">
      <view class="pt"><text class="num text-strong">{{user.pointBalance || 0}}</text><text class="lbl">积分</text></view>
      <view class="pt"><text class="num text-strong">{{user.totalAmount/100 || 0}}</text><text class="lbl">累计消费 ¥</text></view>
    </view>
  </view>

  <view class="card m16 order-card">
    <view class="row top">
      <text class="text-strong">我的订单</text>
      <text class="text-sub text-sm" bindtap="goOrders">全部 ›</text>
    </view>
    <view class="row icons">
      <view class="ic" bindtap="goTab" data-tab="UNPAID"><text class="em">💳</text><text>待支付</text></view>
      <view class="ic" bindtap="goTab" data-tab="ONGOING"><text class="em">🥤</text><text>进行中</text></view>
      <view class="ic" bindtap="goTab" data-tab="DONE"><text class="em">✅</text><text>已完成</text></view>
    </view>
  </view>

  <view class="card m16 list">
    <view class="row top" bindtap="goMyCoupons">
      <text class="em">🎟️</text><text class="text-strong">我的优惠券</text><text class="arrow">›</text>
    </view>
    <view class="row top" bindtap="goPoints">
      <text class="em">⭐</text><text class="text-strong">积分明细</text><text class="arrow">›</text>
    </view>
    <view class="row top" bindtap="goAddress">
      <text class="em">📍</text><text class="text-strong">收货地址</text><text class="arrow">›</text>
    </view>
    <view class="row top" bindtap="goStore">
      <text class="em">🏬</text><text class="text-strong">当前门店</text>
      <text class="text-sub text-sm text-ellipsis" style="flex:1;text-align:right;padding:0 8rpx">{{store ? store.name : '未选择'}}</text>
      <text class="arrow">›</text>
    </view>
  </view>

  <view class="logout" bindtap="onLogout">退出登录</view>
  <view class="tabbar-spacer"></view>
</view>
