.page { padding: 0 0 40rpx; }
.hero {
  background: linear-gradient(180deg, #E4002B 0%, #FF5B5B 100%);
  color: #fff; padding: 60rpx 24rpx 100rpx; text-align: center;
}
.avatar { width: 140rpx; height: 140rpx; border-radius: 50%; margin: 0 auto; display: flex; align-items: center; justify-content: center; font-size: 72rpx; color: #fff; box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.15); }
.name { font-size: 36rpx; margin-top: 16rpx; }
.meta { display: flex; align-items: center; justify-content: center; gap: 12rpx; margin-top: 8rpx; }
.meta .phone { font-size: 24rpx; opacity: 0.85; }
.points { display: flex; justify-content: space-around; margin-top: 24rpx; }
.pt { display: flex; flex-direction: column; align-items: center; }
.pt .num { font-size: 36rpx; }
.pt .lbl { font-size: 22rpx; opacity: 0.85; margin-top: 4rpx; }

.m16 { margin: -60rpx 16rpx 0; }
.card { padding: 20rpx; }
.order-card { margin-bottom: 16rpx; }
.row { display: flex; align-items: center; }
.row.top { padding: 16rpx 0; justify-content: space-between; border-bottom: 1rpx solid var(--border); }
.row.icons { justify-content: space-around; padding: 16rpx 0 4rpx; border: none; }
.row.icons .ic { display: flex; flex-direction: column; align-items: center; gap: 8rpx; font-size: 24rpx; color: var(--text-sub); }
.row.icons .em { font-size: 48rpx; }
.list .row.top { gap: 12rpx; }
.list .em { font-size: 36rpx; }
.arrow { color: var(--text-mute); font-size: 28rpx; }
.logout { text-align: center; color: var(--text-mute); padding: 40rpx 0 24rpx; font-size: 26rpx; }
