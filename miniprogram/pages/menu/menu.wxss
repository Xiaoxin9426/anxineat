.page { display: flex; flex-direction: column; height: 100vh; padding: 0; background: #fff; }
.head {
  display: flex; align-items: center; gap: 8rpx;
  padding: 16rpx 24rpx; background: var(--primary); color: #fff;
}
.head-loc { font-size: 28rpx; }
.head-name { flex: 1; font-size: 26rpx; font-weight: 600; }
.head-arrow { font-size: 24rpx; opacity: 0.85; }

.body { flex: 1; display: flex; min-height: 0; }
.cat {
  width: 180rpx; background: #F5F6F8;
}
.cat-item {
  position: relative;
  padding: 28rpx 12rpx; font-size: 26rpx; color: var(--text);
  text-align: center; line-height: 1.4;
}
.cat-item.on { background: #fff; color: var(--primary); font-weight: 600; }
.cat-item.on::before {
  content: ''; position: absolute; left: 0; top: 30%; bottom: 30%;
  width: 6rpx; background: var(--primary); border-radius: 0 4rpx 4rpx 0;
}

.list-scroll { flex: 1; padding: 0 16rpx; }
.sec { padding: 12rpx 0 24rpx; }
.sec-title { padding: 16rpx 8rpx; font-size: 26rpx; font-weight: 600; color: var(--text-sub); }
.p-card {
  display: flex; gap: 20rpx; padding: 20rpx 12rpx; background: #fff;
  border-radius: 16rpx; margin-bottom: 16rpx;
}
.p-card.off { opacity: 0.55; }
.p-img { width: 180rpx; height: 180rpx; border-radius: 16rpx; overflow: hidden; background: #F0F0F3; flex-shrink: 0; }
.p-img image { width: 100%; height: 100%; }
.p-info { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.p-name { font-size: 28rpx; }
.p-desc { margin-top: 8rpx; line-height: 1.4; }
.p-meta { margin-top: auto; display: flex; align-items: baseline; gap: 12rpx; }
.p-price { font-size: 32rpx; }
.p-cal, .p-sales { font-size: 22rpx; }
.p-so { margin-top: 6rpx; color: var(--danger); }
.pad-bottom { height: 200rpx; }

.loading { padding: 24rpx; display: flex; flex-direction: column; gap: 16rpx; }
.sk-block { height: 200rpx; }

.cart-bar {
  position: fixed; left: 0; right: 0; bottom: 0;
  display: flex; align-items: center; justify-content: space-between;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(0,0,0,0.85); color: #fff; z-index: 10;
}
.cart-bar-l { display: flex; align-items: center; gap: 16rpx; }
.cart-ico {
  width: 88rpx; height: 88rpx; border-radius: 50%;
  background: var(--primary); display: flex; align-items: center; justify-content: center;
  font-size: 40rpx; margin-top: -40rpx; box-shadow: 0 4rpx 16rpx rgba(228,0,43,0.4);
}
.cart-qty { font-size: 28rpx; }
.cart-sum { font-size: 22rpx; opacity: 0.85; }
.cart-bar-r {
  background: var(--primary); padding: 16rpx 32rpx; border-radius: 999rpx;
  font-size: 28rpx; font-weight: 600;
}
