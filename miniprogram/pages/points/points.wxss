.page { padding: 0 0 40rpx; }
.hero {
  background: linear-gradient(180deg, #E4002B 0%, #FF5B5B 100%);
  color: #fff; padding: 48rpx 24rpx 64rpx; text-align: center;
}
.bal { font-size: 88rpx; }
.bal-lbl { font-size: 24rpx; opacity: 0.85; margin-top: 4rpx; }
.meta { display: flex; padding: 24rpx 0 0; align-items: center; justify-content: space-between; }
.meta-l, .meta-c { display: flex; flex-direction: column; gap: 4rpx; flex: 1; }
.meta-r { width: 200rpx; }
.sign-btn { width: 100%; height: 64rpx; line-height: 64rpx; font-size: 26rpx; }
.m24 { margin: 24rpx; }
.section-title-sm { font-size: 28rpx; font-weight: 600; margin-bottom: 12rpx; }
.ex-row { display: flex; align-items: center; justify-content: space-between; padding: 16rpx 0; border-bottom: 1rpx solid var(--border); }
.ex-row:last-child { border-bottom: none; }
.ex-l { display: flex; flex-direction: column; gap: 4rpx; min-width: 0; }
.ex-btn { width: 200rpx; height: 64rpx; line-height: 64rpx; font-size: 24rpx; padding: 0; }
.rec { display: flex; justify-content: space-between; align-items: center; padding: 16rpx 0; border-bottom: 1rpx solid var(--border); }
.rec:last-child { border-bottom: none; }
.rec-l, .rec-r { display: flex; flex-direction: column; align-items: flex-end; }
.rec-l { align-items: flex-start; }
