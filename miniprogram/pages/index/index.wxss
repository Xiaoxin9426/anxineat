.page { padding-bottom: 40rpx; }

.hero {
  background: linear-gradient(180deg, #E4002B 0%, #FF5B5B 60%, transparent 100%);
  padding: 24rpx 24rpx 80rpx;
  color: #fff;
  margin-bottom: -60rpx;
}
.hero-row { display: flex; align-items: center; justify-content: space-between; height: 64rpx; }
.loc {
  display: flex; align-items: center; gap: 8rpx;
  background: rgba(255,255,255,0.18);
  padding: 10rpx 18rpx; border-radius: 999rpx;
  max-width: 80%;
}
.loc-pin { font-size: 26rpx; }
.loc-name { font-size: 26rpx; max-width: 400rpx; }
.loc-arrow { font-size: 28rpx; }

.banner { height: 220rpx; border-radius: 20rpx; overflow: hidden; margin-top: 16rpx; }
.bn {
  height: 100%; display: flex; align-items: center; justify-content: center;
  color: #fff; gap: 20rpx;
}
.bn-emoji { font-size: 64rpx; }
.bn-text { font-size: 32rpx; font-weight: 600; }

.vip {
  margin-top: 24rpx;
  display: flex; align-items: center; justify-content: space-between;
  background: linear-gradient(135deg, #FFD100 0%, #FFB300 100%);
  color: #5A4500;
}
.vip-l { flex: 1; min-width: 0; }
.vip-name { display: flex; align-items: center; gap: 12rpx; }
.vip-greet { font-size: 30rpx; font-weight: 700; }
.vip-points { margin-top: 12rpx; display: flex; align-items: baseline; gap: 8rpx; }
.vip-points .num { font-size: 48rpx; font-weight: 800; }
.vip-points .lbl { font-size: 24rpx; }
.vip-bar { margin-top: 12rpx; }
.vip-bar-bg { height: 8rpx; background: rgba(255,255,255,0.5); border-radius: 4rpx; overflow: hidden; }
.vip-bar-fg { height: 100%; background: #5A4500; }
.vip-bar-tip { margin-top: 6rpx; color: #6B5200; }
.vip-r { padding-left: 24rpx; }
.sign {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  background: #fff; color: #5A4500; width: 110rpx; height: 110rpx; border-radius: 24rpx;
  font-size: 26rpx; font-weight: 600;
}
.sign-ico { font-size: 36rpx; margin-bottom: 6rpx; }
.sign.signed { background: rgba(255,255,255,0.7); color: #8A8A8F; }

.cta-wrap { padding: 0 24rpx; }
.cta {
  margin-top: 16rpx;
  display: flex; align-items: center; justify-content: center; gap: 16rpx;
  height: 120rpx; border-radius: 32rpx; color: #fff;
  background: linear-gradient(95deg, #E4002B 0%, #FF5B5B 100%);
  box-shadow: 0 12rpx 32rpx rgba(228, 0, 43, 0.28);
  font-size: 34rpx; font-weight: 700;
}
.cta-emoji { font-size: 48rpx; }
.cta-arrow { font-size: 36rpx; }

.entry {
  margin: 24rpx 24rpx 0; padding: 28rpx 12rpx;
  display: flex; justify-content: space-around;
}
.entry-item { display: flex; flex-direction: column; align-items: center; gap: 8rpx; font-size: 24rpx; }
.entry-ico { width: 80rpx; height: 80rpx; border-radius: 24rpx; display: flex; align-items: center; justify-content: center; font-size: 40rpx; }

.section-title { padding: 32rpx 24rpx 12rpx; font-size: 30rpx; font-weight: 600; }

.rec-card { margin: 0 24rpx; }
.rec-row { display: flex; align-items: center; padding: 16rpx 0; border-bottom: 1rpx solid var(--border); }
.rec-row:last-of-type { border-bottom: none; }
.rec-emoji { font-size: 48rpx; width: 80rpx; text-align: center; }
.rec-info { flex: 1; min-width: 0; }
.rec-name { font-size: 28rpx; font-weight: 600; }
.rec-price { font-size: 32rpx; font-weight: 700; }
.rec-more { text-align: center; padding: 16rpx 0 0; color: var(--primary); font-size: 26rpx; }
