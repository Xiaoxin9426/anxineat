.page { padding: 0 0 40rpx; }
.hero {
  background: linear-gradient(180deg, #E4002B 0%, #FF5B5B 100%);
  color: #fff; padding: 60rpx 24rpx 80rpx; text-align: center;
}
.hero.fail { background: linear-gradient(180deg, #6E6E78 0%, #444 100%); }
.big-emoji { font-size: 96rpx; }
.big-title { font-size: 40rpx; font-weight: 700; margin-top: 8rpx; }
.big-sub { font-size: 24rpx; opacity: 0.85; margin-top: 8rpx; }
.m24 { margin: 24rpx; }
.card { padding: 24rpx; }
.row { display: flex; align-items: center; }
.kv { justify-content: space-between; padding: 8rpx 0; font-size: 26rpx; }
.pick-title { text-align: center; font-size: 24rpx; color: var(--text-sub); }
.pick-code {
  text-align: center; font-size: 96rpx; font-weight: 800; letter-spacing: 16rpx;
  color: var(--primary); padding: 24rpx 0;
}
.pick-tip { text-align: center; }
.actions { display: flex; flex-direction: column; gap: 16rpx; }
.btn { height: 88rpx; line-height: 88rpx; font-size: 30rpx; font-weight: 600; text-align: center; border-radius: 999rpx; }
.zoom-mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; background: rgba(0,0,0,0.85); z-index: 100; display: flex; align-items: center; justify-content: center; }
.zoom-box { padding: 60rpx 80rpx; background: #fff; border-radius: 32rpx; text-align: center; }
.zoom-code { font-size: 200rpx; font-weight: 900; color: var(--primary); letter-spacing: 24rpx; line-height: 1; }
.loading { padding: 24rpx; }
.sk-block { height: 200rpx; }
