<view class="page">
  <view class="head">{{from === 'confirm' ? '选择收货地址' : '收货地址'}}</view>

  <view class="loading" wx:if="{{loading}}">
    <view class="skeleton sk-row" wx:for="{{[1,2]}}" wx:key="*this"></view>
  </view>

  <view class="list" wx:elif="{{list.length}}">
    <view wx:for="{{list}}" wx:key="id"
          class="card m16 a {{from==='confirm' && item.id===selectedId?'on':''}}"
          data-id="{{item.id}}" bindtap="onPick">
      <view class="row top">
        <text class="text-strong">{{item.name}}</text>
        <text class="text-sub">{{item.phone}}</text>
        <text wx:if="{{item.tag}}" class="tag tag-ghost">{{item.tag}}</text>
        <text wx:if="{{item.isDefault}}" class="tag">默认</text>
      </view>
      <view class="addr text-sub">{{item.province}} {{item.city}} {{item.district}} {{item.detail}}</view>
      <view class="ops">
        <view wx:if="{{!item.isDefault}}" class="op" data-id="{{item.id}}" catchtap="onDefault">设为默认</view>
        <view class="op" data-id="{{item.id}}" catchtap="onEdit">编辑</view>
        <view class="op danger" data-id="{{item.id}}" catchtap="onDelete">删除</view>
      </view>
    </view>
  </view>

  <empty wx:else text="还没有收货地址" icon="📍" buttonText="新增地址" />
  <view class="tabbar-spacer"></view>

  <view class="foot safe-bottom" wx:if="{{!from || from !== 'confirm'}}">
    <view class="btn btn-primary" bindtap="onEdit">+ 新增地址</view>
  </view>
</view>
